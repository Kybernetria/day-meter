<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/checkpoint_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/checkpoint_label_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="60"
            android:maxLines="1" />

        <TextView
            android:id="@+id/checkpoint_today_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/checkpoint_today_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <Button
                android:id="@+id/checkpoint_done_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/chain_done_today" />
            <Button
                android:id="@+id/checkpoint_skip_today"
                style="@style/Widget.Material3.Button.TextButton"
            android:textColor="?attr/colorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/checkpoint_action_skip" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/checkpoint_trigger_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/checkpoint_clock_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:checked="true"
                android:text="@string/checkpoint_clock_time" />

            <RadioButton
                android:id="@+id/checkpoint_percent_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/checkpoint_day_percentage" />
        </RadioGroup>

        <Button
            android:id="@+id/checkpoint_time_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="?attr/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checkpoint_default_time" />

        <TextView
            android:id="@+id/checkpoint_percent_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="@string/checkpoint_percent_value_default"
            android:textStyle="bold"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/checkpoint_percent_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/checkpoint_day_percentage"
            android:max="100"
            android:progress="50"
            android:visibility="gone" />

        <Button
            android:id="@+id/checkpoint_days_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="?attr/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checkpoint_every_day" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chain_section"
            android:textStyle="bold"
            android:paddingTop="16dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/checkpoint_predecessor"
            android:text="@string/chain_wait_for" />
        <Spinner
            android:id="@+id/checkpoint_predecessor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
        <TextView
            android:id="@+id/checkpoint_chain_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chain_help" />
        <Button
            android:id="@+id/checkpoint_chain_details"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="?attr/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/chain_details_title" />
        <TextView
            android:id="@+id/checkpoint_chain_delay_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/checkpoint_chain_delay"
            android:text="@string/chain_delay_hint" />
        <EditText
            android:id="@+id/checkpoint_chain_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="number"
            android:importantForAutofill="no"
            android:maxLength="4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/checkpoint_notification_mode"
            android:paddingTop="8dp"
            android:text="@string/checkpoint_notification_style" />

        <Spinner
            android:id="@+id/checkpoint_notification_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:entries="@array/notif_mode_entries" />

        <Button
            android:id="@+id/checkpoint_channel_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="?attr/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/notif_system_controls_title" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notif_system_controls_summary" />

        <CheckBox
            android:id="@+id/checkpoint_show_marker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/checkpoint_show_marker" />

        <CheckBox
            android:id="@+id/checkpoint_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/checkpoint_enabled" />
        <Button
            android:id="@+id/checkpoint_delete_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textColor="?attr/colorError"
            android:text="@string/checkpoint_delete" />
    </LinearLayout>
</ScrollView>
